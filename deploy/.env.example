# 이 파일을 .env로 복사해서 값을 채우세요 (.env는 git에 올리지 않음)
POSTGRES_DB=tome
POSTGRES_USER=tome
POSTGRES_PASSWORD=

# openssl rand -base64 32 로 만든 값 (32바이트 이상)
JWT_SECRET_KEY=

# 프론트엔드 주소 (여러 개면 쉼표로 구분)
CORS_ALLOWED_ORIGINS=

# 프론트와 서버 도메인이 다르면 true / None (HTTPS 필수)
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=None

# 같은 EC2에서 itda와 함께 띄우면 80 대신 다른 포트 (예: 8081)
NGINX_PORT=80
